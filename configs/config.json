{
    "_": "fidelity: fast | standard | fine",

    "case_name": "RP14_2",
    "stl_files": ["RP14.STL"],
    "fidelity": "standard",

    "flow": {
        "velocity": 16.67,
        "direction": "-z",
        "ground": true
    },

    "outputs": {
        "drag_axis": "-z",
        "downforce_axis": "-y"
    },

    "_domain": "bounding box [x, y, z] in meters",
    "domain_box": {
        "min": [-0.1185, -0.310, -15.0],
        "max": [3.5, 4.5, 6.5]
    },

    "_faces": "available: inlet, outlet, ground, farField, symmetry",
    "domain_faces": {
        "-x": "symmetry",
        "+x": "farField",
        "-y": "ground",
        "+y": "farField",
        "+z": "inlet",
        "-z": "outlet"
    },

    "_parallel": "Number of cores (processes) to use",
    "parallel": {
        "n_procs": 64
    },

    "_slurm": "Override SLURM settings for CU e-Science cluster here",
    "slurm": {
        "qos": "cu_hpc",
        "partition": "cpu",
        "nodes": 1,
        "time": "24:00:00",
        "mem_per_cpu": "3G",
        "openfoam_module": ["GCC/11.3.0", "OpenMPI/4.1.4-GCC-11.3.0"],
        "openfoam_source": "$HOME/OpenFOAM/OpenFOAM-v2606/etc/bashrc"
    },

    "overrides": {
        "mesh_params": {
            "base_cell_size": 0.10,
            "surface_level": [3, 7],
            "edge_level": 8,
            "resolveFeatureAngle": 15,
            "distance_levels": [
                [0.004, 6],
                [0.015, 4],
                [0.040, 2]
            ]
        },
        "layers": {
            "n_layers": 5,
            "expansion_ratio": 1.2,
            "first_layer_thickness": 0.3,
            "featureAngle": 150
        },
        "feature_extract": {
            "includedAngle": 150
        }
    }
}

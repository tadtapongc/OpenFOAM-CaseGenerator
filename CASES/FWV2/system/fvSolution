FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
solvers
{
    p
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-07;
        relTol          0.001;
        nPreSweeps      0;
        nPostSweeps     2;
        cacheAgglomeration true;
        agglomerator    faceAreaPair;
        nCellsInCoarsestLevel 500;
        mergeLevels     1;
    }

    Phi
    {
        $p;
    }

    "(U|k|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0.01;
        minIter         1;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 2;
    consistent      true;
}

potentialFlow
{
    nNonOrthogonalCorrectors 10;
}

relaxationFactors
{
    equations { U 0.6; k 0.5; omega 0.5; }
    fields    { p 0.5; }
}

boundedFields
{
    k       { min 1e-6; }
    omega   { min 1e-4; }
}



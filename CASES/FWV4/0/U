FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 -16.67);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 0 -16.67);
    }
    outlet
    {
        type            zeroGradient;
    }
    ground
    {
        type            fixedValue;
        value           uniform (0 0 -16.67);
    }
    farField
    {
        type            slip;
    }
    symmetry
    {
        type            symmetry;
    }
    FrontWing
    {
        type            noSlip;
    }
}



# ============================================================
# OpenFOAM — Ignore all cases and STL files
# ============================================================

# All generated cases
CASES/

# All STL geometry files
STL/
*.stl
*.STL

# ============================================================
# OpenFOAM generated files (safety net)
# ============================================================

# Mesh
**/constant/polyMesh/
**/constant/extendedFeatureEdgeMesh/
**/constant/triSurface/*.eMesh

# Time step results
**/[1-9]*/
**/[1-9][0-9]*/
**/[1-9][0-9][0-9]*/
**/[1-9][0-9][0-9][0-9]*/
**/[1-9][0-9][0-9][0-9][0-9]*/

# Processor directories
**/processor*/

# Log files
**/log.*

# Post-processing output
**/postProcessing/

# SLURM output logs
**/*_*.log

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# ============================================================
# IDE / Editor
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================================
# OS
# ============================================================
Thumbs.db
.DS_Store

# ============================================================
# OpenFOAM generated files
# ============================================================

# Mesh (large, regenerated by snappyHexMesh)
**/constant/polyMesh/
**/constant/extendedFeatureEdgeMesh/
**/constant/triSurface/*.eMesh

# Time step results (large binary field data)
# Keep 0/ and 0.orig/ (boundary conditions), ignore solver output
**/[1-9]*/
**/[1-9][0-9]*/
**/[1-9][0-9][0-9]*/
**/[1-9][0-9][0-9][0-9]*/
**/[1-9][0-9][0-9][0-9][0-9]*/

# Processor directories (parallel decomposition)
**/processor*/

# Log files (regenerated on each run)
**/log.*

# Post-processing output (regenerated from results)
**/postProcessing/

# SLURM output logs
**/*_*.log

# ============================================================
# STL geometry files (large, tracked separately or via LFS)
# ============================================================
STL/
**/constant/triSurface/*.stl
**/constant/triSurface/*.STL

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# ============================================================
# IDE / Editor
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================================
# OS
# ============================================================
Thumbs.db
.DS_Store
